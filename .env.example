# Copy to .env for local Docker Compose dev — see docker-compose.yml for defaults.

DATABASE_URL=postgresql://app:app@db:5432/find_my_game_parts
NEXTAUTH_URL=http://localhost:3030
NEXTAUTH_SECRET=dev-secret-change-me

# Keycloak realm this app authenticates against. Google/Facebook federation
# is configured INSIDE Keycloak, not here (docs/designs/find-my-game-parts.md,
# Dependencies) — that setup happens in the Keycloak admin console + the
# Google/Facebook developer consoles, which needs the founder's own action.
KEYCLOAK_ISSUER=http://keycloak:8080/realms/find-my-game-parts
KEYCLOAK_CLIENT_ID=find-my-game-parts
KEYCLOAK_CLIENT_SECRET=

# Transactional email (lib/email.ts) — TODOS.md tracked this as missing
# from the design doc's Dependencies; Resend is the provider chosen here.
RESEND_API_KEY=
EMAIL_FROM=no-reply@findmygameparts.example

BGG_API_BASE=https://boardgamegeek.com/xmlapi2
