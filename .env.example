# Copy to .env for local Docker Compose dev — see docker-compose.yml for defaults.

DATABASE_URL=postgresql://app:app@db:5432/find_my_game_parts
NEXTAUTH_URL=http://localhost:3030
NEXTAUTH_SECRET=dev-secret-change-me

# Keycloak realm this app authenticates against. Google/Facebook federation
# is configured INSIDE Keycloak, not here (docs/designs/find-my-game-parts.md,
# Dependencies) — that setup happens in the Keycloak admin console + the
# Google/Facebook developer consoles, which needs the founder's own action.
#
# KEYCLOAK_ISSUER is NOT listed here on purpose — docker-compose.yml sets it
# directly to the internal Docker network address (http://keycloak:8080/...)
# and ignores any value from .env. Don't add it here; it won't do anything
# (this is exactly the bug that caused the browser to be redirected to an
# unreachable "keycloak:8080" URL — see the README's Keycloak setup section).
#
# KEYCLOAK_PUBLIC_URL, below, is the one you actually might need to change —
# only if you remap Keycloak's host port away from 8090 in docker-compose.yml.
KEYCLOAK_PUBLIC_URL=http://localhost:8090
KEYCLOAK_REALM=find-my-game-parts
KEYCLOAK_CLIENT_ID=find-my-game-parts
# No KEYCLOAK_CLIENT_SECRET — the client is public (Authorization Code +
# PKCE only, see lib/auth.ts and keycloak/setup-realm.sh).

# Keycloak group whose members get isAdmin (lib/auth.ts, synced on every
# login — see README's "Admins are managed via Keycloak groups"). If you
# change this, create/rename the matching group in Keycloak's console too.
KEYCLOAK_ADMIN_GROUP=admin

# Transactional email (lib/email.ts) — TODOS.md tracked this as missing
# from the design doc's Dependencies. Mailjet — same provider Keycloak
# already sends through (keycloak/setup-realm.sh) for this domain, kept
# to one email service for the whole project.
# claim@ (not noreply@) so buyer replies land in a real inbox — see
# "Two-way claim email" in the README for the Cloudflare/provider setup.
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
EMAIL_FROM=claim@findmygame.parts

# BGG's XML API requires a registered, approved application token since
# July 2, 2025 — without it, searches silently return empty (graceful
# fallback to manual freeform game entry, not an error).
BGG_API_BASE=https://boardgamegeek.com/xmlapi2
BGG_API_TOKEN=

# Cloudflare Web Analytics beacon token (Cloudflare dashboard → Analytics &
# Logs → Web Analytics → your site → Manage site). Leave empty locally so
# dev traffic isn't counted; analytics is fully off when unset.
CF_WEB_ANALYTICS_TOKEN=
